VOCALCOMPASS_ENV=development
VOCALCOMPASS_API_PREFIX=/api/v1
VOCALCOMPASS_DATA_DIR=./data
VOCALCOMPASS_CORS_ORIGINS=http://localhost:5173
VOCALCOMPASS_MAX_UPLOAD_SIZE_BYTES=104857600
VOCALCOMPASS_AUTO_RUN_ANALYSIS_PIPELINE=true
VOCALCOMPASS_DEMUCS_EXECUTABLE=.venv-demucs/bin/demucs
VOCALCOMPASS_DEMUCS_MODEL=htdemucs
VOCALCOMPASS_BASIC_PITCH_EXECUTABLE=.venv-pitch/bin/basic-pitch
VOCALCOMPASS_WHISPERX_EXECUTABLE=.venv-whisperx/bin/whisperx
VOCALCOMPASS_WHISPERX_MODEL=small
VOCALCOMPASS_WHISPERX_DEVICE=cpu
VOCALCOMPASS_WHISPERX_COMPUTE_TYPE=int8
VOCALCOMPASS_FFPROBE_EXECUTABLE=ffprobe

